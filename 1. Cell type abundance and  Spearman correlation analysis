mat <- wide %>% select(-orig.ident, -condition) %>% as.matrix()

cor_table <- combn(colnames(mat), 2, simplify = FALSE) %>%
  map_dfr(function(pair) {
    ct <- cor.test(mat[, pair[1]], mat[, pair[2]],
                   method = "spearman", exact = FALSE)
    tibble(CellType1 = pair[1], CellType2 = pair[2],
           rho       = round(ct$estimate, 4),
           p_value   = ct$p.value)
  }) %>%
  mutate(p_adj_BH = p.adjust(p_value, method = "BH")) %>%
  arrange(p_value)

write.csv(cor_table, "all_pairwise_spearman.csv", row.names = FALSE)
