make_scatter <- function(data, x_var, y_var) {
  
  plot_df <- data %>%
    select(orig.ident, condition,
           x = all_of(x_var),
           y = all_of(y_var))
  
  # Spearman rho + p
  ct      <- cor.test(plot_df$x, plot_df$y, method = "spearman", exact = FALSE)
  rho_val <- round(ct$estimate, 4)
  p_raw   <- ct$p.value
  p_label <- ifelse(p_raw < 0.0001,
                    formatC(p_raw, format = "e", digits = 2),
                    sprintf("%.4f", p_raw))

  # Axis limits
  x_breaks <- pretty(c(0, max(plot_df$x, na.rm = TRUE)), n = 4)
  y_breaks <- pretty(c(0, max(plot_df$y, na.rm = TRUE)), n = 4)
  x_max    <- max(x_breaks)
  y_max    <- max(y_breaks)
  
  ggplot(plot_df, aes(x = x, y = y)) +
    coord_cartesian(
      xlim = c(min(x_breaks), x_max),
      ylim = c(min(y_breaks), y_max)
    ) +
    geom_smooth(
      method    = "lm",
      se        = FALSE,
      color     = "black",
      linewidth = 0.7
    ) +
    geom_point(
      aes(color = condition),
      shape = 16,
      size  = 3.8
    ) +
    scale_color_manual(values = condition_colors, drop = FALSE, guide = "none") +
    annotate(
      "text",
      x         = min(x_breaks),
      y         = y_max * 0.98,
      label     = paste0("p = ", p_label, "\nrho = ", rho_val),
      hjust     = 0, vjust = 1,
      size      = 3.0,
      color     = "black",
      lineheight = 1.25
    ) +
    scale_x_continuous(breaks = x_breaks, expand = c(0, 0)) +
    scale_y_continuous(breaks = y_breaks, expand = c(0, 0)) +
    labs(x = x_var, y = y_var) +
    theme_classic(base_size = 10) +
    theme(
      panel.border      = element_rect(color = "black", fill = NA, linewidth = 0.6),
      panel.background  = element_rect(fill = "white"),
      plot.background   = element_rect(fill = "white", color = NA),
      axis.line         = element_blank(),
      axis.ticks        = element_line(color = "black", linewidth = 0.4),
      axis.ticks.length = unit(2.5, "pt"),
      axis.text         = element_text(color = "black", size = 8),
      axis.title.x      = element_text(color = "white", face = "bold",
                                        size = 8.5, margin = margin(t = 3)),
      axis.title.y      = element_text(color = "white", face = "bold",
                                        size = 8.5, margin = margin(r = 3)),
      plot.margin       = margin(6, 8, 2, 2)
    )
}

color_axis_titles <- function(p, x_var, y_var) {
  
  x_color <- unname(celltype_colors[x_var])
  y_color <- unname(celltype_colors[y_var])
  
  make_grob <- function(label, bg, rot = 0) {
    grobTree(
      rectGrob(gp = gpar(fill = bg, col = NA)),
      textGrob(label, rot = rot,
               gp = gpar(col = "white", fontsize = 8.5, fontface = "bold"))
    )
  }
  
  g  <- ggplotGrob(p)
  xi <- which(g$layout$name == "xlab-b")
  yi <- which(g$layout$name == "ylab-l")
  if (length(xi)) g$grobs[[xi]] <- make_grob(x_var, x_color, rot = 0)
  if (length(yi)) g$grobs[[yi]] <- make_grob(y_var, y_color, rot = 90)
  g
}

scatter_panel <- function(x_var, y_var) {
  color_axis_titles(make_scatter(wide, x_var, y_var), x_var, y_var)
}

