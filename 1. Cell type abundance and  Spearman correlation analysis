## Figure 2B. abundance plot
# ===============================

library(dplyr)
library(ggplot2)
library(scales)

condition_colors <- c(
  "Control" = "#7F7F7F",
  "R2"      = "#6deb47",
  "Sham"    = "#4c7eb4")

cluster_order <- c(
  "PMN","Angio-TAM","IFN-TAM","Inflam-TAM","LA-TAM",
  "TIM","Mig-DC","cDC1","cDC2-like","pDC",
  "B cell","CD8 T cell","CD4 T cell","Treg",
  "NK","NK2","NK3","Prolif-NK","Basophil/Mast","Osteoclast-like","Prolif-osteoclast-like","Low-quality")

######## sccomp differential composition generated by following https://github.com/MangiolaLaboratory/sccomp  
sccomp_df <- read.csv("sccomp_result.csv") 

sig_df <- sccomp_df %>%
  filter(factor == "condition", c_FDR < 0.05) %>%
  mutate(
    condition = case_when(
      parameter == "conditionR2"   ~ "R2",
      parameter == "conditionSham" ~ "Sham"
    ),
    cluster = Predicted.Ident,
    sig_label = case_when(
      c_FDR < 0.001 ~ "***",
      c_FDR < 0.01  ~ "**",
      c_FDR < 0.05  ~ "*"
    )
  ) %>%
  select(cluster, condition, c_FDR, sig_label)

metadata <- seurat_obj_filtered@meta.data
metadata$cluster <- as.character(Idents(seurat_obj_filtered))

abundance_df <- metadata %>%
  group_by(orig.ident, condition, cluster) %>%
  summarise(n_cells = n(), .groups = "drop") %>%
  group_by(orig.ident) %>%
  mutate(
    total_cells   = sum(n_cells),
    abundance_pct = (n_cells / total_cells) * 100
  ) %>%
  ungroup()

condition_order  <- c("Control", "R2", "Sham")
present_clusters <- intersect(cluster_order, unique(abundance_df$cluster))

abundance_df$condition <- factor(abundance_df$condition, levels = condition_order)
abundance_df$cluster   <- factor(abundance_df$cluster,   levels = present_clusters)

######## Build ggsignif annotation df — one row per significant contrast per cluster
# x positions: Control=1, R2=2, Sham=3

signif_df <- sig_df %>%
  mutate(
    xmin = 1,  # always vs Control
    xmax = case_when(
      condition == "R2"   ~ 2,
      condition == "Sham" ~ 3
    )
  ) %>%
  # y position: per cluster, stack if both R2 and Sham are sig
  left_join(
    abundance_df %>%
      group_by(cluster) %>%
      summarise(y_max = max(abundance_pct, na.rm = TRUE), .groups = "drop"),
    by = "cluster"
  ) %>%
  group_by(cluster) %>%
  arrange(xmax) %>%  # R2 bracket lower, Sham higher if both present
  mutate(
    y_bracket = y_max * (1.1 + (row_number() - 1) * 0.15)
  ) %>%
  ungroup() %>%
  mutate(cluster = factor(cluster, levels = present_clusters))

######## PERCENT ABUNDANCE — FACETED BOXPLOT
abundance_plot <- ggplot(
  abundance_df,
  aes(x = condition, y = abundance_pct)
) +
  geom_boxplot(
    aes(fill = cluster),
    alpha         = 0.7,
    outlier.shape = NA,
    show.legend   = FALSE
  ) +
  geom_jitter(width = 0.2, size = 1, alpha = 0.8) +
  # Significance brackets  *** NEW ***
  geom_signif(
    data        = signif_df,
    aes(
      xmin        = xmin,
      xmax        = xmax,
      annotations = sig_label,
      y_position  = y_bracket
    ),
    manual      = TRUE,
    tip_length  = 0.02,
    textsize    = 4,
    fontface    = "bold",
    colour      = "black",
    inherit.aes = FALSE
  ) +
  facet_wrap(~cluster, scales = "free_y", ncol = 5) +
  scale_fill_manual(values = cluster_colors) +
  # expand y so brackets don't get clipped
  scale_y_continuous(expand = expansion(mult = c(0.05, 0.25))) +
  labs(
    y = "Abundance (%)",
    x = "Condition"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    strip.text  = element_text(size = 10),   # back to simple
    axis.text.x = element_text(angle = 0, hjust = 0.5, colour = "black"),
    axis.text.y = element_text(colour = "black"),
    axis.title  = element_text(colour = "black"))

abundance_plot <- abundance_plot +
  labs(    caption = "Brackets indicate statistically significant compositional differences vs. Control (sccomp).\n* FDR < 0.05   ** FDR < 0.01   *** FDR < 0.001" ) +
  theme(    plot.caption = element_text(size = 8, colour = "grey30", hjust = 0, margin = margin(t = 8))  )

